# --- Database ---
# PostgreSQL — Render's managed database. Locally, a Docker/local Postgres
# works the same way: postgresql://user:password@localhost:5432/pulseline_clinic
DATABASE_URL="postgresql://postgres:password@localhost:5432/pulseline_clinic"

# --- Server ---
PORT=5000
NODE_ENV=development
# One or more comma-separated origins allowed to call this API with
# credentials (cookies). Include your deployed frontend URL in production,
# e.g.: https://pulseline-clinic.onrender.com,http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- Cookies ---
COOKIE_SECRET=replace-with-a-long-random-string

# --- Mailer (Nodemailer) — used for OTP / notification emails ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace-me
SMTP_FROM="Pulseline Clinic <no-reply@pulseline.clinic>"

# --- eSewa (ePay v2) ---
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace-with-esewa-secret
ESEWA_SUCCESS_URL=http://localhost:5173/portal/billing/success
ESEWA_FAILURE_URL=http://localhost:5173/portal/billing/failure

# --- Khalti ---
KHALTI_SECRET_KEY=replace-with-khalti-secret
KHALTI_RETURN_URL=http://localhost:5173/portal/billing/success

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Cloudinary (avatars, medical reports, certificates, patient documents) ---
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
